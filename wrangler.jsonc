{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-library",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // Publicado em https://my-library.eliasvictor2452.workers.dev, protegido pelo Access
  // (Worker → Settings → Domains & Routes → workers.dev → Enable Cloudflare Access).
  // As URLs de preview ficam desligadas: seriam mais um endereço a proteger.
  "workers_dev": true,
  "preview_urls": false,
  // Com domínio próprio no futuro: "routes": [{ "pattern": "estante.seudominio.com", "custom_domain": true }]
  // e "workers_dev": false.
  "assets": {
    // SPA: rotas desconhecidas devolvem index.html; só /api/* passa pelo Worker.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "estante",
      "database_id": "0f0848a2-1371-4d66-ace5-621bf3c0416c",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "estante-pdfs"
    }
  ],
  "observability": { "enabled": true },
  // Em `wrangler dev`, mantém o host como localhost mesmo se houver uma route (senão o
  // DEV_SKIP_ACCESS, que só vale em localhost, deixa de funcionar).
  "dev": { "host": "localhost" }
  // ACCESS_TEAM_DOMAIN, ACCESS_AUD e ALLOWED_EMAIL ficam em `wrangler secret put`, nunca aqui.
}

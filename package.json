{
  "name": "estante-de-leitura",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "npm run build && wrangler dev",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.worker.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply estante --local",
    "db:migrate:remote": "wrangler d1 migrations apply estante --remote",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types worker/worker-configuration.d.ts",
    "build:demo": "vite build --mode demo && node scripts/check-demo-bundle.mjs",
    "deploy:demo": "npm run build:demo && wrangler deploy --config wrangler.demo.jsonc",
    "preview:demo": "vite preview --mode demo",
    "demo:pdfs": "node scripts/demo-pdfs.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "fflate": "0.8.3",
    "hono": "4.13.13",
    "idb": "8.0.3",
    "jose": "6.2.12",
    "pdfjs-dist": "6.4.299"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.5",
    "@cloudflare/vitest-plugin": "1.3.6",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "22.20.5",
    "@vitest/runner": "4.1.11",
    "@vitest/snapshot": "4.1.11",
    "fake-indexeddb": "6.2.5",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "4.1.11",
    "workbox-build": "7.4.1",
    "workbox-window": "7.4.1",
    "wrangler": "4.147.0"
  },
  "allowScripts": {
    "workerd@1.20261001.1": true,
    "esbuild@0.28.1": true
  },
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=11"
  }
}

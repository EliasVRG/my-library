{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "types": ["vite/client", "vite-plugin-pwa/svelte", "vite-plugin-pwa/info"],
    // Vite troca para backend/demo.ts no build demo; os dois exportam o mesmo tipo.
    "paths": { "$backend": ["./src/lib/backend/prod.ts"] }
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "shared/**/*.ts", "tests/unit/**/*.ts"]
}
